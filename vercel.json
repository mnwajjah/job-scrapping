{
  "functions": {
    "api/search.js":  { "maxDuration": 60, "memory": 1536 },
    "api/match.js":   { "maxDuration": 60 },
    "api/cron/scrape.js": { "maxDuration": 60, "memory": 1024 },
    "api/cron/match.js":  { "maxDuration": 60, "memory": 1024 },
    "api/cron/notify.js": { "maxDuration": 60, "memory": 1024 },
    "api/debug-db.js":    { "maxDuration": 15 },
    "api/jobs.js":    { "maxDuration": 15 },
    "api/auth.js":    { "maxDuration": 10 },
    "api/sources.js": { "maxDuration": 10 },
    "api/health.js":  { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)",     "destination": "/index.html" }
  ]
}
