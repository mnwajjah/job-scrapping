# ═══════════════════════════════════════════════════════════
#  Cocok v2 — Environment Variables
#  Salin file ini ke .env untuk local dev, atau set di Vercel
# ═══════════════════════════════════════════════════════════

# ── AI (WAJIB) ───────────────────────────────────────────
GEMINI_API_KEY=AIza...

# ── Auth (WAJIB) ─────────────────────────────────────────
# Password untuk login ke dashboard
DASHBOARD_PASSWORD=wajjah2026

# Secret untuk sign JWT (buat string acak panjang)
JWT_SECRET=ganti-dengan-string-acak-yang-panjang-dan-random

# ── Cron Security (WAJIB) ────────────────────────────────
# Header x-cron-secret yang dikirim cron-job.org
# Set di cron-job.org sebagai header: x-cron-secret: <nilai ini>
CRON_SECRET=ganti-dengan-string-rahasia-cron

# ── Email via Resend (WAJIB untuk email) ─────────────────
# Daftar gratis di https://resend.com — free tier 3000 email/bulan
RESEND_API_KEY=re_...

# Email tujuan (kamu)
EMAIL_TO=mwajjah@gmail.com

# Email pengirim (harus verified domain di Resend)
# Kalau belum punya domain: pakai onboarding@resend.dev untuk testing
EMAIL_FROM=noreply@yourdomain.com

# ── Database via Turso (WAJIB untuk tracker) ──────────────────────────────
# Daftar gratis di https://turso.tech → buat DB → copy URL & token
# CLI: turso db create cocok-jobs && turso db show cocok-jobs --url && turso db tokens create cocok-jobs
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-token-here
